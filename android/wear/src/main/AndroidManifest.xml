<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <!-- No internet permission: the watch only talks to the Bops app on the user's own phone. -->
    <!-- Installs updates the phone sends (Android shows its own confirm screen; the user taps OK). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Bops"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Needs the phone app: it relays to Bops over Tailscale and keeps the pairing code. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WatchActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Updates and version questions from the Bops phone app (Data Layer: same app, same key only). -->
        <service android:name=".UpdateReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/bops/watch-version" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/bops/update-apk/" />
            </intent-filter>
        </service>
        <receiver android:name=".InstallStatus" android:exported="false" />
    </application>
</manifest>
